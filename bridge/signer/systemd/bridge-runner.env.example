# bridge-runner.env.example — the settings of the bridge RUNNER: the machine that pays the
# bridge's fees, with beldex-bridge-relay-watch (EVM gas: mints, key hand-offs, standby naming,
# takeover steps) and beldex-bridge-handover-submit (the gateway hand-over's Beldex fee).
# Copy to /etc/beldex/bridge-runner.env (setup-node.sh runner does), fill in every <...>, then
# run `setup-node.sh check-runner`. It holds no bridge key: the committee signs everything,
# the runner only pays to put it on chain, and anyone could do the same with the same payloads.
#
# Run a second runner on another machine with the same settings (its own wallets and gas key):
# a payload sent twice is refused by the chain the second time, before any gas is spent.

# ── The bus: the runner's own beldexd ────────────────────────────────────────────────────────
# Start it with --lmq-public tcp://0.0.0.0:<port> (that port open to the seats only); the seats
# publish their signed payloads to it (their BRIDGE_SIGNER_MINT_BUS_ENDPOINT). Comma-separated;
# the first one also answers committee queries.
BRIDGE_SIGNER_OXENMQ_ENDPOINT=ipc:///var/lib/beldex/beldexd.sock
BRIDGE_SIGNER_BELDEXD_RPC_URL=http://127.0.0.1:19091

# ── relay-watch: EVM gas ─────────────────────────────────────────────────────────────────────
BRIDGE_SIGNER_RELAY_CMD=/usr/bin/beldex-bridge-relayer relay -
# Every wBDX chain and the runner's own RPC for it.   testnet: chain_id 97
RELAYER_CHAINS=[{"chain_id":56,"rpc_url":"https://<runner's BSC RPC>"}]
RELAYER_STATE_DIR=/var/lib/beldex-bridge/relay/state
# The gas key is NOT here: it is the systemd credential relayer-gas-key, read from
# /etc/beldex/relayer-gas.key (64 hex characters, root-only). Keep only gas money on it.

# ── handover-submit: the gateway hand-over ───────────────────────────────────────────────────
# Its own Beldex wallet (beldex-wallet-rpc --rpc-login, bound to 127.0.0.1), used for nothing
# else: spending the outputs a built hand-over uses would void it.
BRIDGE_SIGNER_HANDOVER_WALLET_RPC=http://127.0.0.1:19093/json_rpc
BRIDGE_SIGNER_HANDOVER_WALLET_LOGIN_FILE=/etc/beldex/bridge-handover-wallet.login
# The reserve gateway's id (64 hex) and the wBDX chains (same rows as the seats', with the
# runner's own RPC).
BRIDGE_SIGNER_RELEASE_GATEWAY=<64 hex gateway id>
BRIDGE_SIGNER_EVM_CHAINS=[{"chain_id":56,"contract":"0x<wBDX proxy>","rpc":"https://<runner's BSC RPC>","confirmations":15,"per_tx_max":"<contract perTxMax>","per_epoch_cap":"<contract windowMintCap>"}]
# Where the committee's leader asks for a build (the seats' BRIDGE_SIGNER_HANDOVER_BUILDER).
# Open to the seats only.
BRIDGE_SIGNER_HANDOVER_LISTEN=0.0.0.0:18090
# Its records, one per hand-over: back them up with the wallet's seed (another machine can
# carry on from them).
BRIDGE_SIGNER_HANDOVER_DIR=/var/lib/beldex-bridge/handover/records

# ── Monitoring (handover-submit) ─────────────────────────────────────────────────────────────
BRIDGE_SIGNER_STATUS_LISTEN=127.0.0.1:9110
# Report the hand-over wallet low below this many atomic units (here 50 BDX).
BRIDGE_SIGNER_WALLET_LOW=50000000000
