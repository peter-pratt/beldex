# bridge-signer.env.example — the settings of ONE bridge seat (one master node with a bridge
# seat, on its own server). Copy to /etc/beldex/bridge-signer-<seat>.env (setup-node.sh does),
# fill in every value marked <...>, then run `setup-node.sh check <seat>`.
#
# Read by all three of the seat's services: beldex-bridge-serve@<seat> (signs mints, releases
# and key hand-offs with the live key), beldex-bridge-dkg@<seat> (makes and attests each epoch's
# key when the seat is drawn) and beldex-bridge-standby@<seat> (the standby key and takeover).
# The last two read their own overrides after this file; see the end of this file.
#
# Values shown are mainnet's; testnet's differ where noted.

# ── The seat's own beldexd ───────────────────────────────────────────────────────────────────
BRIDGE_SIGNER_BELDEXD_RPC_URL=http://127.0.0.1:19091
# Its OxenMQ socket (beldexd --lmq-local-control / the data dir's beldexd.sock).
BRIDGE_SIGNER_OXENMQ_ENDPOINT=ipc:///var/lib/beldex/beldexd.sock
# The master node's key: it signs the seat's mesh messages and key attestations.
BRIDGE_SIGNER_MN_KEY_FILE=/var/lib/beldex/key_ed25519
BRIDGE_SIGNER_SELF_MN_PUBKEY=<64 hex: this master node's pubkey>
# The chain's genesis block hash: binds the seat's attestations and bus messages to this chain.
BRIDGE_SIGNER_GENESIS_HASH=<64 hex: get_block_header_by_height 0>

# ── Bridge parameters: must equal consensus (cryptonote_config.h) ────────────────────────────
# mainnet 2880 / 14     testnet 360 / 3
BRIDGE_SIGNER_BRIDGE_EPOCH_BLOCKS=2880
BRIDGE_SIGNER_COMMITTEE_THRESHOLD=14

# ── The bridge: the same on every seat ───────────────────────────────────────────────────────
# The reserve gateway: its id (64 hex, not the gwB… address) and the view secret that lets the
# seat read deposits (it cannot spend).
BRIDGE_SIGNER_GATEWAY_ID=<64 hex>
BRIDGE_SIGNER_GATEWAY_VIEW_SECRET=<64 hex>
# Every wBDX chain, with THIS seat's own EVM RPC (a different provider per seat; no provider
# for more than ~20-25 of the 100 seats). confirmations / caps must equal the contract's.
#   testnet: chain_id 97 (BSC testnet)
BRIDGE_SIGNER_EVM_CHAINS=[{"chain_id":56,"contract":"0x<wBDX proxy>","rpc":"https://<this seat's BSC RPC>","confirmations":15,"per_tx_max":"<contract perTxMax>","per_epoch_cap":"<contract windowMintCap>","start_block":<deploy block>,"implementation":"0x<implementation>","implementation_codehash":"0x<codehash>"}]
# Where signed payloads go for the runner (mints, hand-offs, standby steps): the bus daemons the
# runner listens to. The bus does not spread payloads between daemons, so these must be the
# runner's: its beldexd (and a backup's) started with --lmq-public tcp://0.0.0.0:<port>, that
# port open to the seats only. Two, so one down is not the bus down.
BRIDGE_SIGNER_MINT_BUS_ENDPOINT=tcp://<runner>:<port>,tcp://<backup runner>:<port>
# The runner's hand-over submitter: the leader asks it to build the gateway hand-over.
BRIDGE_SIGNER_HANDOVER_BUILDER=http://<runner>:18090
# Deposits from this height on (the bridge's activation height).
BRIDGE_SIGNER_BELDEX_START_HEIGHT=<height>

# ── The seat's shares ────────────────────────────────────────────────────────────────────────
# The live share tree; dkg-auto writes the next key beside it (shares-next) and the standby
# signer its own (shares-standby). The sealing key comes as the systemd credential
# bridge-share-key from /etc/beldex/bridge-share-<seat>.key (setup-node.sh makes it).
BRIDGE_SIGNER_SHARE_DIR=/var/lib/beldex/bridge-<seat>/shares

# ── The seat's fee wallet ────────────────────────────────────────────────────────────────────
# A small wallet of its own (NOT the operator wallet that holds the bond): it pays the seat's
# key attestations, rotation acks and standby steps. A local beldex-wallet-rpc started with
# --rpc-login, bound to 127.0.0.1; its user:password in an owner-only (0600) file.
BRIDGE_SIGNER_ACK_WALLET_RPC=http://127.0.0.1:19092/json_rpc
BRIDGE_SIGNER_ACK_WALLET_LOGIN_FILE=/etc/beldex/bridge-fee-wallet-<seat>.login

# ── Signing mesh (open these ports between the seats) ────────────────────────────────────────
# Live signing: Pgw on 6000+index, Pevm on 6100+index, the coordinator on 6200+index.
BRIDGE_SIGNER_MESH_PORT_BASE=6000
BRIDGE_SIGNER_SERVE_LIVE=1
# Supervised by systemd: wait for a share set, follow hand-overs and takeovers by restarting.
BRIDGE_SIGNER_SUPERVISED=1

# ── Monitoring ───────────────────────────────────────────────────────────────────────────────
# GET /status and /health (503 + the problems when something is wrong).
BRIDGE_SIGNER_STATUS_LISTEN=127.0.0.1:9100

# ── Never on mainnet ─────────────────────────────────────────────────────────────────────────
# BRIDGE_SIGNER_MESH_USE_CURVE=false, BRIDGE_SIGNER_ALLOW_PLAINTEXT_SHARES, BRIDGE_SIGNER_SHARE_KEY,
# BRIDGE_SIGNER_BELDEX_CONFIRMATIONS and "depth_only_finality" are test-network settings: the
# signer refuses them unless its daemon is on a devnet.


# ════════════════════════════════════════════════════════════════════════════════════════════
# /etc/beldex/bridge-dkg-<seat>.env — dkg-auto's overrides (read after this file):
#
#   BRIDGE_SIGNER_DKG_PORT_BASE=7000          # its DKG on 7000/7100+index, activation on 7200
#   BRIDGE_SIGNER_STATUS_LISTEN=127.0.0.1:9101
#
# ════════════════════════════════════════════════════════════════════════════════════════════
# /etc/beldex/bridge-standby-<seat>.env — the standby signer's overrides (read after this file):
#
#   BRIDGE_SIGNER_ROLE=standby
#   BRIDGE_SIGNER_SHARE_DIR=/var/lib/beldex/bridge-<seat>/shares-standby
#   BRIDGE_SIGNER_PROMOTE_TO=/var/lib/beldex/bridge-<seat>/shares
#   BRIDGE_SIGNER_MESH_PORT_BASE=8000          # 8000/8100/8200+index
#   BRIDGE_SIGNER_STATUS_LISTEN=127.0.0.1:9102
#   # How long a deposit stays final and unminted before the standby takes over (mainnet 600).
#   BRIDGE_SIGNER_OUTAGE_WINDOW_SECS=600
