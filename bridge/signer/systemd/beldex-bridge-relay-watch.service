# beldex-bridge-relay-watch.service — the runner's EVM relayer: it takes every committee-signed
# mint, rotateSigner, activateRotation, setStandby and standby takeover step off the bus and
# sends it with the relayer's gas key, holding an activation until the contract's challenge
# window is over.
#
#   /etc/beldex/bridge-runner.env (bridge-runner.env.example), at least:
#     BRIDGE_SIGNER_OXENMQ_ENDPOINT   the bus daemons, comma-separated
#     BRIDGE_SIGNER_RELAY_CMD         "/usr/bin/beldex-bridge-relayer relay -"
#     RELAYER_CHAINS                  [{"chain_id":56,"rpc_url":"https://..."}]
#     RELAYER_STATE_DIR               its in-flight transactions
#   The EVM gas key (pays gas only; it cannot move bridge funds) is the systemd credential
#   relayer-gas-key, from /etc/beldex/relayer-gas.key (64 hex, root-only).

[Unit]
Description=Beldex bridge EVM relayer (relay-watch)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=beldex
Group=beldex
EnvironmentFile=/etc/beldex/bridge-runner.env
LoadCredential=relayer-gas-key:/etc/beldex/relayer-gas.key
WorkingDirectory=/var/lib/beldex-bridge/relay
ExecStart=/usr/bin/beldex-bridge-signer relay-watch
Restart=always
RestartSec=5

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
ReadWritePaths=/var/lib/beldex-bridge

[Install]
WantedBy=multi-user.target
